{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "catjump",
  "outputfilename": "catjump",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "CatJump"
  },
  "info": {
    "companyName": "CatJump",
    "productName": "CatJump",
    "productVersion": "0.1.0",
    "copyright": "CatJump contributors",
    "comments": "Share files directly, powered by tailcat",
    "protocols": [
      {
        "scheme": "catjump",
        "description": "CatJump share link",
        "role": "Viewer"
      }
    ]
  }
}
